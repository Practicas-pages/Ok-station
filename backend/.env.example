# ============================================================
# Ok.station — Variables de entorno (PRODUCCIÓN)
# Copia este archivo como  .env  y complétalo en CloudPanel.
# .env NUNCA se sube al repositorio (ver .gitignore).
# Nunca se colocan credenciales dentro del código: TODO sale de aquí.
# ============================================================

# ── Base de datos ──
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# ── Aplicación ──
APP_URL=https://okstation.mx
APP_ENV=production              # production | development
CORS_ORIGIN=https://okstation.mx

# ── Seguridad (JWT) ──
# Genera uno con: php -r "echo bin2hex(random_bytes(48));"
JWT_SECRET=
JWT_TTL=604800                  # 7 días en segundos

# ── Administradores "bootstrap" ──
# Correos que reciben el rol 'administrador' al registrarse.
# Después se gestionan por rol en la BD/panel (no se usan como correos fijos en el código).
ADMIN_EMAILS=

# ── Correo SMTP (confirmación de citas/pedidos, recuperación de contraseña) ──
# Para enviar desde una cuenta de Google Workspace/Gmail (p. ej. practicas@okdock.mx):
#   SMTP_HOST=smtp.gmail.com  ·  SMTP_PORT=587
#   SMTP_USER = la cuenta completa  ·  SMTP_PASSWORD = "Contraseña de aplicación"
#   (genérala en https://myaccount.google.com/apppasswords con la verificación en
#    2 pasos activada; son 16 caracteres, pégalos SIN espacios).
#   SMTP_FROM debe ser la MISMA cuenta (Gmail no deja falsear el remitente).
SMTP_HOST=
SMTP_PORT=587                   # 587 STARTTLS (recomendado) | 465 SSL
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@okstation.mx
SMTP_FROM_NAME=Ok.station

# ── Correo transaccional con Brevo (recomendado: adjunta el comprobante PDF) ──
# Si pones BREVO_API_KEY, los correos de pedidos/citas se envían por la API de
# Brevo y se ADJUNTA el comprobante (PDF). Si lo dejas vacío, se usa el SMTP de
# arriba (sin adjuntos). El remitente MAIL_FROM DEBE estar verificado en Brevo.
# La API key se obtiene en Brevo → SMTP & API → API Keys (empieza con "xkeysib-").
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Ok.station

# ── Almacenamiento de archivos (PDFs de clientes, imágenes, tickets) ──
# Ruta ABSOLUTA, idealmente FUERA de la raíz pública del sitio.
# En CloudPanel suele ser algo como: /home/<sitio>/storage
STORAGE_PATH=/home/okstation/storage
MAX_UPLOAD_MB=25

# ── Reseñas de Google (Places API) ──
# Si quedan vacías, el sitio solo muestra las reseñas propias (no se rompe nada).
# 1) Crea una API key en Google Cloud con "Places API" habilitada.
# 2) Saca el Place ID de Ok.station: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Pago en línea ──
# Proveedor del checkout. 'sandbox' = checkout local de demostración (sin pasarela,
# ideal para pruebas). 'stripe' = Stripe Checkout. 'mercadopago' = Mercado Pago Checkout Pro.
PAYMENT_PROVIDER=sandbox          # sandbox | stripe | mercadopago
PAYMENT_CURRENCY=MXN
# Secreto compartido para el webhook de sandbox (genera uno con:
#   php -r "echo bin2hex(random_bytes(24));"  ). Solo se usa en modo sandbox.
PAYMENT_SANDBOX_SECRET=
# Stripe (solo si PAYMENT_PROVIDER=stripe):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago (solo si PAYMENT_PROVIDER=mercadopago):
#   MP_ACCESS_TOKEN  = Access Token (secreto de servidor; TEST: APP_USR-… de prueba).
#   MP_PUBLIC_KEY    = Public Key (solo si el front usa el SDK/Bricks de MP).
#   MP_WEBHOOK_SECRET= (opcional) "clave secreta" del webhook en el panel de MP.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ── Diagnóstico de instalación (temporal; vacío = deshabilitado) ──
SETUP_TOKEN=
