# ============================================================
# Ok.station — .gitignore (estándar de seguridad empresarial)
# ============================================================

# ── Sistema operativo ──
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editores / IDE ──
.vscode/
.idea/
*.code-workspace

# ── Claude Code (local) ──
.claude/

# ── Dependencias ──
# OJO: solo el vendor de Composer (raíz y backend). NO usar "vendor/" a secas:
# también excluía assets/vendor/ (Leaflet self-hosted) y el mapa daba 404 en
# producción porque sus archivos nunca entraban al repo.
/vendor/
backend/vendor/
node_modules/

# ── SECRETOS Y CONFIGURACIÓN (NUNCA al repositorio) ──
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
backend/api/config.php
config.php
config.prod.php
config.production.php
credentials.json
service-account.json
firebase-admin.json
*.key
*.pem
*.p12
# EXCEPCION: el intermedio de GoDaddy que nextep.com.mx no manda. NO es secreto:
# es un certificado PUBLICO, publicado por GoDaddy en una URL abierta. Sin el, la
# verificacion TLS contra NEXTEP falla en produccion y no se pueden traer sus fotos.
# Va en el repo a proposito; la regla *.pem de arriba es para llaves PRIVADAS.
!backend/api/lib/certs/godaddy-g2.pem
id_rsa
id_rsa.pub

# ── Datos de clientes / archivos generados (no son código) ──
backend/storage/uploads/
backend/storage/tickets/
storage/
uploads/
tickets/
backups/
cache/
tmp/
sessions/
logs/
*.log

# ── Dumps / respaldos de BD ──
# (Las migraciones, schema.sql y seed.sql SÍ se versionan: son código fuente.)
*.dump
*.sql.gz
db_*.sql
backup_*.sql
dump_*.sql

# ── Empaquetados ──
*.zip
*.tar.gz
*.rar

# ── Estado local / preview ──
.image-slots.state.json
.thumbnail
# serve.ps1 se mantiene a propósito (servidor de preview local).

# Imágenes de productos descargadas por el runner (generadas, no se versionan)
assets/img/products/
